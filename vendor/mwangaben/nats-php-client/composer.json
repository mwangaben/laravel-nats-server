{
  "name": "nats-php/nats-client",
  "description": "Official PHP client for NATS messaging system",
  "type": "library",
  "keywords": [
    "nats",
    "messaging",
    "microservices",
    "pubsub",
    "queue",
    "php-nats",
    "nats-php"
  ],
  "license": "MIT",
  "version": "1.0.0-dev",
  "authors": [
    {
      "name": "Benedict Mwanga",
      "email": "mwangaben@gmail.com",
      "homepage": "https://github.com/mwangaben",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.9",
    "friendsofphp/php-cs-fixer": "^3.92"
  },
  "autoload": {
    "psr-4": {
      "Nats\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nats\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-unit": "vendor/bin/phpunit --testsuite \"Unit Tests\"",
    "test-integration": "vendor/bin/phpunit --testsuite \"Integration Tests\"",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "test-connection": "php tests/test-connection.php",
    "lint": "vendor/bin/phpcs --standard=PSR12 src/",
    "lint-fix": "vendor/bin/phpcbf --standard=PSR12 src/",
    "stan": "vendor/bin/phpstan analyse src/ --level=7",
    "cs-fix": "vendor/bin/php-cs-fixer fix src/",
    "check": [
      "@lint",
      "@stan",
      "@test-unit"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "ext-sockets": "For better network performance"
  }
}
